# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

*.mp4

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

**eval/*

**/exp_data*/*
**.csv
**/exp_data/*
**/exp_data_corl**/*
**/analysis/*
**/evaluation/*
# **/exp_data_corl_02/*
*.csv
*.pt
*.json
!liquid_collection/*manifest.json
**/diagnostics/*

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Deployment sources are versioned; exports, golden vectors, manifests,
# generated historical-source snapshots, and packaged bundles stay local.
/deployments/**
!/deployments/**/
!/deployments/**/*.py
!/deployments/**/*.sh
!/deployments/**/*.cpp
!/deployments/**/*.h
!/deployments/**/*.hpp
!/deployments/**/CMakeLists.txt
!/deployments/**/*.rst
!/deployments/**/*.md
/deployments/**/archive/
/deployments/**/__pycache__/

# Reproducible evaluation tooling only, not collected trials/reports/plots.
!/diagnostics/matched5500/
/diagnostics/matched5500/*
!/diagnostics/matched5500/evaluate.py
!/diagnostics/matched5500/report.py
!/diagnostics/matched5500/README.txt
!/diagnostics/oct07_qp_comparison/
/diagnostics/oct07_qp_comparison/*
!/diagnostics/oct07_qp_comparison/README.txt

# Large media files
*.tiff
*.avi
*.flv
*.mov
*.wmv

# VS Code
.vscode
# logs
logs
runs

# other
*.egg-info
__pycache__
wandb
build
*debug*
resources/terrains/*.stl

# Compact discrete-physics validation summary (no trajectories).
!docs/liquid_discrete_validation_v1.json
